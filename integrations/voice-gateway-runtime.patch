diff --git a/tests/test_runtime_resolution.py b/tests/test_runtime_resolution.py
new file mode 100644
--- /dev/null
+++ b/tests/test_runtime_resolution.py
@@ -0,0 +1,56 @@
+import json
+from pathlib import Path
+import tempfile
+import tomllib
+import unittest
+
+from codex_assistant.app_server import AppServerError, resolve_codex_launch
+
+
+class RuntimeResolutionTest(unittest.TestCase):
+    def test_current_pointer_rebases_only_owned_paths(self):
+        with tempfile.TemporaryDirectory() as directory:
+            base = Path(directory)
+            root = base / "OpenAI" / "Codex-Windows-SSH"
+            config_home = base / "config"
+            config_home.mkdir()
+            root.mkdir(parents=True)
+            env = {"LOCALAPPDATA": str(base), "CODEX_HOME": str(config_home), "PATH": ""}
+            old = root / "1.2.3.4-r1" / "app"
+            original = (
+                f"notify = [{json.dumps(str(old / 'notify.exe'))}, 'turn-ended']\n"
+                "[mcp_servers.node_repl]\n"
+                f"command = {json.dumps(str(old / 'node_repl.exe'))}\n"
+                "[mcp_servers.node_repl.env]\n"
+                f"NODE_REPL_NODE_MODULE_DIRS = {json.dumps(str(old / 'node_modules'))}\n"
+                "CUSTOM_PATH = 'C:/unrelated/keep'\n"
+                "TRUSTED_HASH = 'do-not-change'\n"
+            )
+            config = config_home / "config.toml"
+            config.write_text(original, encoding="utf-8")
+            for runtime_id in ("2.3.4.5-r2", "3.4.5.6-r3"):
+                runtime = root / runtime_id
+                resources = runtime / "app" / "resources"
+                resources.mkdir(parents=True)
+                cli = resources / "codex.exe"
+                cli.touch()
+                (runtime / "installed.json").write_text(json.dumps({"validation": {"status": "passed"}}))
+                (root / "current.version").write_text(runtime_id + "\n")
+                executable, overrides = resolve_codex_launch("codex", env)
+                self.assertEqual(Path(executable), cli)
+                parsed = tomllib.loads("\n".join(overrides[1::2]))
+                self.assertEqual(Path(parsed["mcp_servers"]["node_repl"]["command"]), runtime / "app" / "node_repl.exe")
+                self.assertNotIn("CUSTOM_PATH", " ".join(overrides))
+                self.assertNotIn("TRUSTED_HASH", " ".join(overrides))
+                self.assertEqual(config.read_text(encoding="utf-8"), original)
+                self.assertEqual(resolve_codex_launch("custom-codex", env)[0], "custom-codex")
+            (root / "current.version").write_text("../outside")
+            with self.assertRaises(AppServerError):
+                resolve_codex_launch("codex", env)
+
+    def test_normal_path_installation_is_unchanged(self):
+        self.assertEqual(resolve_codex_launch("custom-codex", {"PATH": ""}), ("custom-codex", []))
+
+
+if __name__ == "__main__":
+    unittest.main()
