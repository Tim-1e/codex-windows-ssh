+def resolve_codex_launch(command: str, env: dict[str, str]) -> tuple[str, list[str]]:
+    """Follow the validated install pointer, without rewriting global config."""
+    executable = shutil.which(command, path=env.get("PATH")) or command
+    if not env.get("LOCALAPPDATA"):
+        return executable, []
+    root = Path(env["LOCALAPPDATA"]) / "OpenAI" / "Codex-Windows-SSH"
+    pointer = root / "current.version"
+    if not pointer.is_file():
+        return executable, []
+    runtime_id = pointer.read_text(encoding="utf-8").strip()
+    if not re.fullmatch(r"\d+\.\d+\.\d+\.\d+(?:-r\d+)?", runtime_id):
+        raise AppServerError("Invalid current Codex runtime ID")
+    runtime = root / runtime_id
+    metadata = json.loads((runtime / "installed.json").read_text(encoding="utf-8"))
+    if metadata.get("validation", {}).get("status") != "passed":
+        raise AppServerError("The selected Codex runtime is not validated")
+    app = runtime / "app"
+    bundled_cli = app / "resources" / "codex.exe"
+    if not bundled_cli.is_file():
+        raise AppServerError("The selected Codex runtime has no bundled CLI")
+    if command.lower() in ("codex", "codex.exe"):
+        executable = str(bundled_cli)
+
+    config_path = Path(env.get("CODEX_HOME", str(Path.home() / ".codex"))) / "config.toml"
+    if not config_path.is_file():
+        return executable, []
+    config = tomllib.loads(config_path.read_text(encoding="utf-8"))
+    # Only rebase this installation's generated paths. Custom MCPs, trust
+    # hashes, permissions, credentials, and other user settings remain intact.
+    old_app = re.compile(
+        re.escape(root.as_posix()) + r"/\d+\.\d+\.\d+\.\d+(?:-r\d+)?/app(?=/|$)",
+        re.IGNORECASE,
+    )
+
+    def rebase(value: Any) -> Any:
+        if isinstance(value, list):
+            return [rebase(item) for item in value]
+        if isinstance(value, str) and old_app.search(value.replace("\\", "/")):
+            return old_app.sub(lambda _: app.as_posix(), value.replace("\\", "/"))
+        return value
+
+    overrides: list[str] = []
+
+    def visit(key: str, value: Any) -> None:
+        if isinstance(value, dict):
+            for name, item in value.items():
+                visit(key + "." + json.dumps(name), item)
+        else:
+            updated = rebase(value)
+            if updated != value:
+                overrides.extend(("-c", key + "=" + json.dumps(updated, ensure_ascii=False)))
+
+    visit("notify", config.get("notify"))
+    visit("mcp_servers.node_repl", config.get("mcp_servers", {}).get("node_repl", {}))
+    return executable, overrides
+
